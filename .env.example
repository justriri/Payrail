# Payrail configuration. Variable NAMES and non-secret defaults only.
# NEVER put a private key in this file or in this folder (it may be synced to the cloud or committed).

# --- Required ---
# The event's attribution tag. Must match the pinned value exactly or Payrail refuses to run.
PAYRAIL_ATTRIBUTION_TAG=celo_b2fff2ac9413

# --- Optional (defaults shown) ---
PAYRAIL_CHAIN_ID=42220
# Your wallet's PUBLIC address (used for read-only plans and balances). If a key is loaded, the address is
# derived from the key and must match this value.
# PAYRAIL_WALLET_ADDRESS=0x...

# --- RPC (chain reads). https only ---
# Primary endpoint (default: https://forno.celo.org).
# PAYRAIL_RPC_URL=https://...
# Fallbacks used when the primary cannot answer (comma separated). Unset = built-in list
# (rpc.ankr.com/celo, 1rpc.io/celo). Set to an empty value to disable fallbacks.
# PAYRAIL_RPC_FALLBACK_URLS=https://rpc.ankr.com/celo,https://1rpc.io/celo

# --- Spending limits (USD; defaults are deliberately small) ---
# PAYRAIL_MAX_PER_PAYMENT_USD=0.01
# PAYRAIL_MAX_PER_DAY_USD=0.25
# PAYRAIL_MAX_SWAP_USD=2
# PAYRAIL_MAX_SWAP_PER_DAY_USD=5
# PAYRAIL_APPROVAL_ABOVE_USD=0.01
# PAYRAIL_AUTOPAY_SERVICES=x.posts.search
# PAYRAIL_REQUIRE_SWAP_APPROVAL=true
# PAYRAIL_CONVERSION_SLIPPAGE_BPS=100
# PAYRAIL_ALLOWED_HOSTS=gateway.usebuy.ai
# PAYRAIL_ALLOWED_CONVERSIONS=USDT:cNGN,cNGN:USDT

# --- Legacy rehearsal setting ---
PAYRAIL_SELL_AMOUNT_CNGN=1500

# --- SECRET: do NOT set in this folder ---
# Keep the signing key in a file OUTSIDE this project and outside any cloud-synced folder, for example:
#   <your user profile>\.payrail\rehearsal.env      containing the single line:  PAYRAIL_PRIVATE_KEY=0x...
# and load it only for commands that must sign:
#   node --env-file=<that file> scripts/order.ts --service <id> --execute
# See docs/WALLET-KEY-BACKUP.md.

# Buy AI purchases paid by the buyer wallet (USDT on Celo). Off unless 1.
# PAYRAIL_BUY_PAYMENTS=1
# PAYRAIL_BUY_MAX_USD=0.05
# Pay with cNGN, wARS, wBRL, USDC, USAT... : Textile converts in the buyer wallet first. Needs PAYRAIL_BUY_PAYMENTS=1.
# Textile minimum swap is about 1 USD, so keep the cap at 2 or more.
# PAYRAIL_BUY_CONVERSION=1
# PAYRAIL_BUY_CONVERT_MAX_USD=2

# ---- GitHub verification for sellers (optional). Put YOUR values in .env.local (git-ignored) for local development,
# ---- and use a SEPARATE GitHub OAuth App with an https address for production. Never commit real values.
# Local development (Payrail running at http://127.0.0.1:4402); start with: npm run serve:local
# PAYRAIL_GITHUB_CLIENT_ID=<client id of your LOCAL OAuth App>
# PAYRAIL_GITHUB_CLIENT_SECRET=<client secret of your LOCAL OAuth App>
# PAYRAIL_PUBLIC_URL=http://127.0.0.1:4402
# Production (later): PAYRAIL_PUBLIC_URL=https://your-payrail-domain  (https only; no path)
